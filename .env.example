# WanderBites does not read a .env file at runtime (Flutter bundles assets, and
# secrets in assets ship to every device). Configuration is compile-time via:
#
#   flutter run --dart-define-from-file=dart_defines/dev.json
#
# This file exists to document every variable in one conventional place.
# Copy dart_defines/dev.example.json -> dart_defines/dev.json and fill it in.

# Shared OrbitStack Supabase project URL
SUPABASE_URL=https://pfagkivkytrvbkhsulvo.supabase.co

# Publishable key (sb_publishable_...). Client-safe, protected by RLS.
# Dashboard -> Project Settings -> API keys. NEVER put a service-role key here.
SUPABASE_PUBLISHABLE_KEY=

# The schema WanderBites owns inside the shared project. Do not change.
SUPABASE_SCHEMA=wanderbites

# Google Maps SDK for Android key. Also mirror into android/local.properties
# as MAPS_API_KEY for the native SDK. Optional: app runs without the map.
GOOGLE_MAPS_API_KEY=

# development | staging | production
APP_ENV=development
