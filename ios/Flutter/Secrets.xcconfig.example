// Copy this file to Secrets.xcconfig (gitignored) for a local Xcode build.
// Codemagic writes the real Secrets.xcconfig itself before every CI build -
// see codemagic.yaml - so this file only matters if you ever open the
// project directly in Xcode on a Mac.
GOOGLE_MAPS_API_KEY = AIzaSy_your_ios_maps_key_here
