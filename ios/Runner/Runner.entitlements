<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Without this key iOS never hands the app a device token, so
	     firebase_messaging registers and then silently receives nothing. The
	     build still succeeds, which is what makes it easy to miss: push simply
	     does not arrive and there is no error to chase.

	     "production" is the right value for both TestFlight and the App Store;
	     the "development" environment is only for debug builds signed with a
	     development profile. This project has no Mac and only ever produces
	     release builds through CI, so a development variant would be a moving
	     part guarding a case that cannot happen here. If a Mac ever enters the
	     picture, add a second entitlements file for the Debug configuration
	     rather than changing this value. -->
	<key>aps-environment</key>
	<string>production</string>

	<!-- Sign in with Apple. App Store guideline 4.8 requires an equivalent
	     login option wherever a third-party login is offered, and WanderBites
	     offers Google. Without this entitlement the native sheet fails at
	     runtime with an authorization error rather than at build time, so a
	     missing capability here looks like a broken button, not a config
	     mistake.

	     The matching capability must also be enabled on the App ID in the
	     Apple Developer portal, or CI signing will reject the entitlement. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
